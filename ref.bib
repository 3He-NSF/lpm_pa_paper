@article{nakajima_stroboscopic_2024,
	title = {Stroboscopic time-of-flight neutron diffraction in long pulsed magnetic fields},
	volume = {6},
	url = {https://link.aps.org/doi/10.1103/PhysRevResearch.6.023109},
	doi = {10.1103/PhysRevResearch.6.023109},
	abstract = {We present proof-of-principle experiments of stroboscopic time-of-flight (TOF) neutron diffraction in long pulsed magnetic fields. By utilizing electric double-layer capacitors, we developed a long pulsed magnet for neutron diffraction measurements, which generates pulsed magnetic fields with the full widths at half maximum of {\textgreater}102 ms. The field variation is slow enough to be approximated as a steady field within the time scale of a polychromatic neutron pulse passing through a sample placed in a distance of the order of 101 m from the neutron source. This enables us to efficiently explore the reciprocal space using a wide range of neutron wavelength in high magnetic fields. We applied this technique to investigate field-induced magnetic phases in the triangular lattice antiferromagnets CuFe1−𝑥⁢Ga𝑥⁢O2 (𝑥=0,0.035).},
	number = {2},
	urldate = {2026-10-15},
	journal = {Physical Review Research},
	publisher = {American Physical Society},
	author = {Nakajima, Taro and Watanabe, Masao and Inamura, Yasuhiro and Matsui, Kazuki and Kanda, Tomoki and Nomoto, Tetsuya and Ohishi, Kazuki and Kawamura, Yukihiko and Saito, Hiraku and Tamatsukuri, Hiromu and Terada, Noriki and Kohama, Yoshimitsu},
	month = may,
	year = {2024},
	pages = {023109},
	file = {Full Text PDF:/Users/takahashishingo/Zotero/storage/6GU9HP22/Nakajima et al. - 2024 - Stroboscopic time-of-flight neutron diffraction in long pulsed magnetic fields.pdf:application/pdf},
}
